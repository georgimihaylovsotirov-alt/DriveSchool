@model IReadOnlyList<DriveSchool.Models.LessonBooking>
@{
    ViewData["Title"] = "Общ график";
}
<div class="welcome-row"><div><span class="eyebrow">ЗАНЯТИЯ И СВОБОДНИ ЧАСОВЕ</span><h2>График на школата</h2><p>Всички слотове, заявки и потвърдени уроци за следващите две седмици.</p></div></div>
<section class="panel"><div class="table-wrap"><table class="data-table"><thead><tr><th>Дата и час</th><th>Курсист</th><th>Инструктор</th><th>Автомобил</th><th>Статус</th></tr></thead><tbody>
@foreach (var item in Model)
{
    var label = item.Status switch { DriveSchool.Models.BookingStatus.Available => "Свободен час", DriveSchool.Models.BookingStatus.Pending => "Чака потвърждение", DriveSchool.Models.BookingStatus.Confirmed => "Потвърден", DriveSchool.Models.BookingStatus.Rejected => "Отказан", DriveSchool.Models.BookingStatus.Cancelled => "Отменен", _ => "Проведен" };
    <tr><td><strong>@item.StartsAt.ToString("dd MMM yyyy")</strong><br /><span class="muted">@item.StartsAt.ToString("HH:mm") – @item.EndsAt.ToString("HH:mm")</span></td><td>@(item.StudentProfile?.ApplicationUser.FullName ?? "—")</td><td>@item.InstructorProfile.ApplicationUser.FullName</td><td>@(item.Car is null ? "—" : $"{item.Car.MakeModel} · {item.Car.RegistrationNumber}")</td><td><span class="status status-@item.Status.ToString().ToLowerInvariant()">@label</span></td></tr>
}
@if (Model.Count == 0) { <tr><td colspan="5" class="table-empty">Няма планирани занятия за избрания период.</td></tr> }
</tbody></table></div></section>
