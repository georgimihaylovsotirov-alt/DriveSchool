@model DriveSchool.ViewModels.CarEditViewModel
@{
    ViewData["Title"] = "Редакция на автомобил";
}
<section class="panel"><header class="panel-header"><div><h2>Редакция на автомобил</h2></div></header><div class="panel-body">
<form asp-action="Edit" method="post" class="form-stack">
    <input asp-for="Id" type="hidden" />
    <div class="content-grid">
        <div class="form-field"><label asp-for="MakeModel"></label><input asp-for="MakeModel" /><span asp-validation-for="MakeModel" class="field-error"></span></div>
        <div class="form-field"><label asp-for="RegistrationNumber"></label><input asp-for="RegistrationNumber" /><span asp-validation-for="RegistrationNumber" class="field-error"></span></div>
        <div class="form-field"><label asp-for="Category"></label><select asp-for="Category"><option value="B">B</option><option value="A">A</option><option value="C">C</option><option value="D">D</option></select></div>
        <div class="form-field"><label asp-for="Year"></label><input asp-for="Year" type="number" min="1990" max="2100" /></div>
    </div>
    <label class="checkbox-control"><input asp-for="IsAvailable" /> Наличен за обучение</label>
    <div class="form-actions"><button class="button button-primary" type="submit">Запази промените</button><a class="button button-light" asp-action="Index">Отказ</a></div>
</form></div></section>
