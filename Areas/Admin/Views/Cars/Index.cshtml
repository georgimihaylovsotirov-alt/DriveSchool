@model IReadOnlyList<DriveSchool.Models.Car>
@{
    ViewData["Title"] = "Автомобили";
}
<div class="welcome-row"><div><span class="eyebrow">УЧЕБЕН АВТОПАРК</span><h2>Автомобили</h2><p>Поддържайте регистъра и наличността на автомобилите.</p></div><a class="button button-primary" asp-action="Create">＋ Добави автомобил</a></div>
<section class="panel"><div class="table-wrap"><table class="data-table"><thead><tr><th>Автомобил</th><th>Регистрация</th><th>Категория</th><th>Година</th><th>Статус</th><th>Действия</th></tr></thead><tbody>
@foreach (var item in Model)
{
                    <tr><td><strong>@item.MakeModel</strong></td><td>@item.RegistrationNumber</td><td>@item.Category</td><td>@item.Year</td><td><span class="status @(item.IsAvailable ? "status-available" : "status-rejected")">@(item.IsAvailable ? "Наличен" : "Спрян")</span></td><td><div class="table-actions"><a class="button button-primary button-small" asp-action="Edit" asp-route-id="@item.Id">Редакция</a><a class="button button-danger button-small" asp-action="ConfirmDelete" asp-route-id="@item.Id">Премахни</a></div></td></tr>
}
@if (Model.Count == 0) { <tr><td colspan="6" class="table-empty">Автопаркът все още няма автомобили.</td></tr> }
</tbody></table></div></section>
