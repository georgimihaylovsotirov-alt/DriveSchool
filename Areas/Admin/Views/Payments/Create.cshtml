@model DriveSchool.ViewModels.PaymentCreateViewModel
@{
    ViewData["Title"] = "Ново задължение";
    var students = ViewBag.Students as IReadOnlyList<DriveSchool.Models.StudentProfile> ?? Array.Empty<DriveSchool.Models.StudentProfile>();
}
<section class="panel"><header class="panel-header"><div><h2>Добавяне на плащане</h2><p>Тук се записва задължение. Реално плащане не се обработва от системата.</p></div></header><div class="panel-body">
<form asp-action="Create" method="post" class="form-stack">
    <div class="form-field"><label asp-for="StudentProfileId"></label><select asp-for="StudentProfileId"><option value="">Изберете курсист</option>@foreach (var student in students) { <option value="@student.Id">@student.ApplicationUser.FullName · @student.ApplicationUser.Email</option> }</select><span asp-validation-for="StudentProfileId" class="field-error"></span></div>
    <div class="form-field"><label asp-for="Description"></label><input asp-for="Description" /><span asp-validation-for="Description" class="field-error"></span></div>
    <div class="content-grid"><div class="form-field"><label asp-for="Amount"></label><input asp-for="Amount" type="number" min="0.01" step="0.01" /><span asp-validation-for="Amount" class="field-error"></span></div><div class="form-field"><label asp-for="DueAt"></label><input asp-for="DueAt" type="date" /></div></div>
    <div class="form-actions"><button class="button button-primary" type="submit">Добави задължение</button><a class="button button-light" asp-action="Index">Отказ</a></div>
</form></div></section>
