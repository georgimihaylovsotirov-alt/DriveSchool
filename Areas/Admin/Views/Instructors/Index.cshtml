@model IReadOnlyList<DriveSchool.Models.InstructorProfile>

@{
    ViewData["Title"] = "Инструктори";
}

<div class="welcome-row">
    <div>
        <span class="eyebrow">ЕКИП НА ШКОЛАТА</span>
        <h2>Инструктори</h2>
        <p>Преглеждайте кандидатурите, одобрявайте инструктори и управлявайте профилите.</p>
    </div>
    <a class="button button-primary" asp-action="Create">＋ Нов инструктор</a>
</div>

<section class="panel">
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Инструктор</th>
                    <th>Категории</th>
                    <th>Обучителен автомобил</th>
                    <th>Опит</th>
                    <th>Курсисти</th>
                    <th>Статус на заявката</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <strong>@item.ApplicationUser.FullName</strong><br />
                            <span class="muted">@item.ApplicationUser.Email</span><br />
                            @if (!string.IsNullOrWhiteSpace(item.PhoneNumber))
                            {
                                <span class="muted">@item.PhoneNumber</span>
                            }
                        </td>
                        <td>@item.Categories</td>
                        <td>
                            <strong>@item.TrainingCarMakeModel</strong><br />
                            <span class="muted">@item.TrainingCarRegistrationNumber · @item.TrainingCarYear · кат. @item.TrainingCarCategory</span>
                        </td>
                        <td>@item.YearsExperience г.</td>
                        <td>@item.Students.Count</td>
                        <td>
                            @if (item.ApprovalStatus == DriveSchool.Models.InstructorApprovalStatus.Pending)
                            {
                                <span class="status status-pending">Чака одобрение</span>
                            }
                            else if (item.ApprovalStatus == DriveSchool.Models.InstructorApprovalStatus.Approved)
                            {
                                <span class="status @(item.IsActive ? "status-approved" : "status-rejected")">
                                    @(item.IsActive ? "Одобрен / активен" : "Одобрен / неактивен")
                                </span>
                            }
                            else
                            {
                                <span class="status status-rejected">Отказана заявка</span>
                            }
                        </td>
                        <td>
                            <div class="table-actions">
                                @if (!string.IsNullOrWhiteSpace(item.CvStoredFileName))
                                {
                                    <a class="button button-light button-small"
                                       asp-action="DownloadCv" asp-route-id="@item.Id">Изтегли CV</a>
                                }

                                @if (item.ApprovalStatus == DriveSchool.Models.InstructorApprovalStatus.Pending)
                                {
                                    <form asp-action="Approve" asp-route-id="@item.Id" method="post"
                                          onsubmit="return confirm('Одобрявате ли кандидатурата на този инструктор?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="button button-small btn-activate">Одобри</button>
                                    </form>
                                    <form asp-action="Reject" asp-route-id="@item.Id" method="post"
                                          onsubmit="return confirm('Сигурни ли сте, че искате да откажете кандидатурата?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="button button-danger button-small">Откажи</button>
                                    </form>
                                }
                                else
                                {
                                    <a class="button button-primary button-small" asp-action="Edit" asp-route-id="@item.Id">Редакция</a>

                                    @if (item.IsActive)
                                    {
                                        <form asp-action="Deactivate" asp-route-id="@item.Id" method="post"
                                              onsubmit="return confirm('Сигурни ли сте, че искате да деактивирате този инструктор?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="button button-dark button-small">Деактивиране</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Activate" asp-route-id="@item.Id" method="post"
                                              onsubmit="return confirm('Искате ли да активирате този инструктор?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="button button-small btn-activate">Активиране</button>
                                        </form>
                                    }

                                    <a class="button button-danger button-small" asp-action="ConfirmDelete" asp-route-id="@item.Id">Изтриване</a>
                                }
                            </div>
                        </td>
                    </tr>
                }

                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="table-empty">Няма регистрирани инструктори или кандидатури.</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>
