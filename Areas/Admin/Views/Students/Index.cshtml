
@model IReadOnlyList<DriveSchool.Models.StudentProfile>

@{
    ViewData["Title"] = "Курсисти";
}

<div class="welcome-row">
    <div>
        <span class="eyebrow">УПРАВЛЕНИЕ НА КУРСИСТИ</span>
        <h2>Курсисти</h2>
        <p>Профили, инструктори и статус на обучението.</p>
    </div>

    <a class="button button-primary" asp-action="Create">
        ＋ Нов курсист
    </a>
</div>

<section class="panel">
    <header class="panel-header">
        <div>
            <h2>
                Всички курсисти
                <span class="pill-tag">@Model.Count</span>
            </h2>
        </div>

        <form class="inline-form" method="get">
            <div class="form-field">
                <label for="search">Търсене</label>
                <input id="search"
                       name="search"
                       value="@ViewBag.Search"
                       placeholder="Име или имейл" />
            </div>

            <button class="button button-dark button-small" type="submit">
                Търси
            </button>
        </form>
    </header>

    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Курсист</th>
                    <th>Категория</th>
                    <th>Инструктор</th>
                    <th>Напредък</th>
                    <th>Профил</th>
                    <th>Действия</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var student in Model)
                {
                    <tr>
                        <td>
                            <strong>@student.ApplicationUser.FullName</strong>
                            <br />
                            <span class="muted">
                                @student.ApplicationUser.Email
                            </span>
                        </td>

                        <td>@student.LicenseCategory</td>

                        <td>
                            @(student.InstructorProfile?.ApplicationUser.FullName
                                ?? "Не е назначен")
                        </td>

                        <td>
                            <div class="progress-track" style="width:95px">
                                <span style="width:@student.ProgressPercent%"></span>
                            </div>
                            <small>@student.ProgressPercent%</small>
                        </td>

                        <td>
                            <span class="status @(student.IsActive ? "status-approved" : "status-rejected")">
                                @(student.IsActive ? "Активен" : "Неактивен")
                            </span>
                        </td>

                        <td>
                            <div class="table-actions">

                                <a class="button button-primary button-small"
                                   asp-action="Edit"
                                   asp-route-id="@student.Id">
                                    Редактиране
                                </a>

                                @if (student.IsActive)
                                {
                                    <form asp-action="Deactivate"
                                          asp-route-id="@student.Id"
                                          method="post"
                                          onsubmit="return confirm('Сигурни ли сте, че искате да деактивирате този акаунт?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit" class="button button-dark button-small">
                                            Деактивиране
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Activate"
                                          asp-route-id="@student.Id"
                                          method="post"
                                          onsubmit="return confirm('Искате ли да активирате този акаунт?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit" class="button button-small btn-activate">
                                            Активиране
                                        </button>
                                    </form>
                                }

                                <a class="button button-danger button-small"
                                   asp-action="ConfirmDelete"
                                   asp-route-id="@student.Id">
                                    Изтриване
                                </a>

                            </div>
                        </td>
                    </tr>
                }

                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="table-empty">
                            Няма намерени курсисти.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
